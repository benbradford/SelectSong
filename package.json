{
  "name": "selectsong",
  "version": "0.1.0",
  "description": "Worship song selection tool for Sunday services",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "sync": "tsx src/scripts/sync.ts",
    "import": "tsx src/scripts/import-downloads.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
